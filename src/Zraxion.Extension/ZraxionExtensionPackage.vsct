<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable"
              xmlns:xs="http://www.w3.org/2001/XMLSchema">

	<Extern href="stdidcmd.h" />
	<Extern href="vsshlids.h" />

	<Commands package="guidZraxionExtensionPackage">

		<Menus>
			<Menu guid="guidZraxionExtensionPackageCmdSet"
				  id="ZraxionToolsMenu"
				  priority="0x0100"
				  type="Menu">
				<Parent guid="guidZraxionExtensionPackageCmdSet"
						id="ZraxionToolsPlacementGroup" />
				<Strings>
					<ButtonText>Zraxion</ButtonText>
					<CommandName>Zraxion</CommandName>
				</Strings>
			</Menu>

			<Menu guid="guidZraxionExtensionPackageCmdSet"
				  id="ZraxionAnalyticsMenu"
				  priority="0x0100"
				  type="Menu">
				<Parent guid="guidZraxionExtensionPackageCmdSet"
						id="ZraxionRootGroup" />
				<Strings>
					<ButtonText>Analytics</ButtonText>
					<CommandName>Analytics</CommandName>
				</Strings>
			</Menu>

			<Menu guid="guidZraxionExtensionPackageCmdSet"
				  id="ZraxionCompareMenu"
				  priority="0x0200"
				  type="Menu">
				<Parent guid="guidZraxionExtensionPackageCmdSet"
						id="ZraxionRootGroup" />
				<Strings>
					<ButtonText>Compare</ButtonText>
					<CommandName>Compare</CommandName>
				</Strings>
			</Menu>
		</Menus>

		<Groups>
			<!-- A group must be placed on the built-in Tools menu first. -->
			<Group guid="guidZraxionExtensionPackageCmdSet"
				   id="ZraxionToolsPlacementGroup"
				   priority="0x0600">
				<Parent guid="guidSHLMainMenu"
						id="IDM_VS_MENU_TOOLS" />
			</Group>

			<Group guid="guidZraxionExtensionPackageCmdSet"
				   id="ZraxionRootGroup"
				   priority="0x0100">
				<Parent guid="guidZraxionExtensionPackageCmdSet"
						id="ZraxionToolsMenu" />
			</Group>

			<Group guid="guidZraxionExtensionPackageCmdSet"
				   id="ZraxionAnalyticsGroup"
				   priority="0x0100">
				<Parent guid="guidZraxionExtensionPackageCmdSet"
						id="ZraxionAnalyticsMenu" />
			</Group>

			<Group guid="guidZraxionExtensionPackageCmdSet"
				   id="ZraxionCompareGroup"
				   priority="0x0100">
				<Parent guid="guidZraxionExtensionPackageCmdSet"
						id="ZraxionCompareMenu" />
			</Group>

			<Group guid="guidZraxionExtensionPackageCmdSet"
				   id="ZraxionAboutGroup"
				   priority="0x0300">
				<Parent guid="guidZraxionExtensionPackageCmdSet"
						id="ZraxionToolsMenu" />
			</Group>
		</Groups>

		<Buttons>
			<Button guid="guidZraxionExtensionPackageCmdSet"
					id="InspectResultsGridCommandId"
					priority="0x0100"
					type="Button">
				<Parent guid="guidZraxionExtensionPackageCmdSet"
						id="ZraxionAnalyticsGroup" />
				<Strings>
					<ButtonText>Show Analytics Bar</ButtonText>
				</Strings>
			</Button>

			<Button guid="guidZraxionExtensionPackageCmdSet"
					id="SumSelectedCellsCommandId"
					priority="0x0200"
					type="Button">
				<Parent guid="guidZraxionExtensionPackageCmdSet"
						id="ZraxionAnalyticsGroup" />
				<Strings>
					<ButtonText>Sum Selected Cells</ButtonText>
				</Strings>
			</Button>

			<Button guid="guidZraxionExtensionPackageCmdSet"
					id="AverageSelectedCellsCommandId"
					priority="0x0210"
					type="Button">
				<Parent guid="guidZraxionExtensionPackageCmdSet"
						id="ZraxionAnalyticsGroup" />
				<Strings>
					<ButtonText>Average Selected Cells</ButtonText>
				</Strings>
			</Button>

			<Button guid="guidZraxionExtensionPackageCmdSet"
					id="CountSelectedCellsCommandId"
					priority="0x0220"
					type="Button">
				<Parent guid="guidZraxionExtensionPackageCmdSet"
						id="ZraxionAnalyticsGroup" />
				<Strings>
					<ButtonText>Count Selected Cells</ButtonText>
				</Strings>
			</Button>

			<Button guid="guidZraxionExtensionPackageCmdSet"
					id="MinSelectedCellsCommandId"
					priority="0x0230"
					type="Button">
				<Parent guid="guidZraxionExtensionPackageCmdSet"
						id="ZraxionAnalyticsGroup" />
				<Strings>
					<ButtonText>Minimum Selected Cells</ButtonText>
				</Strings>
			</Button>

			<Button guid="guidZraxionExtensionPackageCmdSet"
					id="MaxSelectedCellsCommandId"
					priority="0x0240"
					type="Button">
				<Parent guid="guidZraxionExtensionPackageCmdSet"
						id="ZraxionAnalyticsGroup" />
				<Strings>
					<ButtonText>Maximum Selected Cells</ButtonText>
				</Strings>
			</Button>

			<Button guid="guidZraxionExtensionPackageCmdSet"
					id="SetComparisonBaselineCommandId"
					priority="0x0100"
					type="Button">
				<Parent guid="guidZraxionExtensionPackageCmdSet"
						id="ZraxionCompareGroup" />
				<Strings>
					<ButtonText>Set Selection as A</ButtonText>
				</Strings>
			</Button>

			<Button guid="guidZraxionExtensionPackageCmdSet"
					id="CompareSelectionWithBaselineCommandId"
					priority="0x0200"
					type="Button">
				<Parent guid="guidZraxionExtensionPackageCmdSet"
						id="ZraxionCompareGroup" />
				<Strings>
					<ButtonText>Compare Selection with A</ButtonText>
				</Strings>
			</Button>

			<Button guid="guidZraxionExtensionPackageCmdSet"
					id="AboutZraxionCommandId"
					priority="0x0100"
					type="Button">
				<Parent guid="guidZraxionExtensionPackageCmdSet"
						id="ZraxionAboutGroup" />
				<Icon guid="guidImages" id="bmpPic1" />
				<Strings>
					<ButtonText>About Zraxion</ButtonText>
				</Strings>
			</Button>
		</Buttons>

		<Bitmaps>
			<!--  The bitmap id is defined in a way that is a little bit different from the others:
            the declaration starts with a guid for the bitmap strip, then there is the resource id of the
            bitmap strip containing the bitmaps and then there are the numeric ids of the elements used
            inside a button definition. An important aspect of this declaration is that the element id
            must be the actual index (1-based) of the bitmap inside the bitmap strip. -->
			<Bitmap guid="guidImages" href="Resources\AboutZraxionCommand.png" usedList="bmpPic1, bmpPic2, bmpPicSearch, bmpPicX, bmpPicArrows, bmpPicStrikethrough" />
			<Bitmap guid="guidImages3" href="Resources\AverageSelectedCellsCommand.png" usedList="bmpPic1, bmpPic2, bmpPicSearch, bmpPicX, bmpPicArrows, bmpPicStrikethrough" />
			<Bitmap guid="guidImages4" href="Resources\MinSelectedCellsCommand.png" usedList="bmpPic1, bmpPic2, bmpPicSearch, bmpPicX, bmpPicArrows, bmpPicStrikethrough" />
			<Bitmap guid="guidImages5" href="Resources\MaxSelectedCellsCommand.png" usedList="bmpPic1, bmpPic2, bmpPicSearch, bmpPicX, bmpPicArrows, bmpPicStrikethrough" />
			<Bitmap guid="guidImages6" href="Resources\CountSelectedCellsCommand.png" usedList="bmpPic1, bmpPic2, bmpPicSearch, bmpPicX, bmpPicArrows, bmpPicStrikethrough" />
			<Bitmap guid="guidImages7" href="Resources\GridAnalyticsSnapshot.png" usedList="bmpPic1, bmpPic2, bmpPicSearch, bmpPicX, bmpPicArrows, bmpPicStrikethrough" />
			<Bitmap guid="guidImages8" href="Resources\GridAnalyticsComparison.png" usedList="bmpPic1, bmpPic2, bmpPicSearch, bmpPicX, bmpPicArrows, bmpPicStrikethrough" />
			<Bitmap guid="guidImages9" href="Resources\GridComparisonSession.png" usedList="bmpPic1, bmpPic2, bmpPicSearch, bmpPicX, bmpPicArrows, bmpPicStrikethrough" />
			<Bitmap guid="guidImages10" href="Resources\SetComparisonBaselineCommand.png" usedList="bmpPic1, bmpPic2, bmpPicSearch, bmpPicX, bmpPicArrows, bmpPicStrikethrough" />
			<Bitmap guid="guidImages11" href="Resources\CompareSelectionWithBaselineCommand.png" usedList="bmpPic1, bmpPic2, bmpPicSearch, bmpPicX, bmpPicArrows, bmpPicStrikethrough" />
		</Bitmaps>
	</Commands>

	<Symbols>
		<GuidSymbol name="guidZraxionExtensionPackage"
					value="{adba31ac-1eb5-48ec-b2e9-5d4fd241b075}" />

		<GuidSymbol name="guidZraxionExtensionPackageCmdSet"
					value="{af1b02be-ba8f-4292-9d65-c7399d43c1e5}">
			<!-- Existing command IDs are unchanged. -->
			<IDSymbol name="AboutZraxionCommandId" value="0x0100" />
			<IDSymbol name="InspectResultsGridCommandId" value="0x0101" />
			<IDSymbol name="SumSelectedCellsCommandId" value="0x0102" />
			<IDSymbol name="AverageSelectedCellsCommandId" value="0x0103" />
			<IDSymbol name="MinSelectedCellsCommandId" value="0x0104" />
			<IDSymbol name="MaxSelectedCellsCommandId" value="0x0105" />
			<IDSymbol name="CountSelectedCellsCommandId" value="0x0106" />
			<IDSymbol name="SetComparisonBaselineCommandId" value="0x0107" />
			<IDSymbol name="CompareSelectionWithBaselineCommandId" value="0x0108" />

			<!-- New menu/group IDs use a separate range for safe rollback. -->
			<IDSymbol name="ZraxionToolsMenu" value="0x1100" />
			<IDSymbol name="ZraxionAnalyticsMenu" value="0x1110" />
			<IDSymbol name="ZraxionCompareMenu" value="0x1120" />
			<IDSymbol name="ZraxionToolsPlacementGroup" value="0x1200" />
			<IDSymbol name="ZraxionRootGroup" value="0x1210" />
			<IDSymbol name="ZraxionAnalyticsGroup" value="0x1220" />
			<IDSymbol name="ZraxionCompareGroup" value="0x1230" />
			<IDSymbol name="ZraxionAboutGroup" value="0x1240" />
		</GuidSymbol>

